_manifestfiles()
{
    local cur prev words cword
    _init_completion || return

    local opts="-h --help --data-dir --manifest-file --include-meta --include-manifest --missing --create"

    case "$prev" in
        --data-dir)
            _filedir -d
            return
            ;;
        --manifest-file)
            _filedir '@(yaml)'
            return
            ;;
        --create)
            _filedir '@(txt)'
            return
            ;;
    esac

    # Complete long options by default.
    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
        return
    fi

    # Positional arguments are not used by manifestfiles.
    COMPREPLY=()
}

complete -F _manifestfiles manifestfiles 
